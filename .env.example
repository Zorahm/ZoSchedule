# ZoSchedule: секреты и настройки окружения для прода.
#
# Скопируйте в `.env` рядом с этим файлом (сам `.env` в git не попадает).
# Настоящие переменные окружения приоритетнее этого файла.
# Пустые значения игнорируются, как будто строки нет.

# --- Telegram-бот -----------------------------------------------------------
# Токен бота от @BotFather. Без него бот не запускается.
ZOSCHEDULE_BOT_TOKEN=

# Кто может управлять ботом: Telegram-id людей через запятую (свой id покажет
# @userinfobot). Только они могут написать /go и добавить бота в группу. Остальные
# игнорируются, а из группы, куда бота добавил чужой, бот сразу выходит. Можно и в
# config.toml (trusted_users); эта переменная приоритетнее.
ZOSCHEDULE_BOT_TRUSTED_USERS=

# Кураторы: id людей через запятую. Их сообщения вида «в 13.50 у ОККИПд-307 пара будет
# в 314 аудитории» бот применяет к расписанию. Нужен выключенный Group Privacy у бота
# (@BotFather → /setprivacy → Disable) или права администратора в группе. Можно и в
# config.toml (curators); эта переменная приоритетнее.
ZOSCHEDULE_BOT_CURATORS=

# Белый список групп: id через запятую (отрицательные, у супергрупп -100...). Из них бот
# не выходит, даже если его добавил недоверенный; команды всё равно только от доверенных.
# Id группы пишется в журнал, когда бот из неё выходит. Можно и в config.toml
# (trusted_chats); эта переменная приоритетнее.
ZOSCHEDULE_BOT_TRUSTED_CHATS=

# Куда писать, если бот ещё ни разу не получал /go. Обычно НЕ нужно: чат
# запоминается по команде /go, которую администратор пишет в группе.
# Для супергруппы id вида -100..., у группы с темами ещё и номер темы.
ZOSCHEDULE_BOT_CHAT_ID=
ZOSCHEDULE_BOT_THREAD_ID=

# --- Необязательное, раскомментируйте при необходимости ---------------------
# Прокси для Telegram, если api.telegram.org недоступен напрямую. Только для
# Telegram: сайт колледжа бот открывает без прокси. Пусто или нет строки: без прокси.
# Вид: socks5://[логин:пароль@]хост:порт (также socks4://, http://, https://).
# ZOSCHEDULE_BOT_PROXY=socks5://127.0.0.1:1080
# ZOSCHEDULE_DB=D:/ZoSchedule/backend/zoschedule.db
# ZOSCHEDULE_CONFIG=D:/ZoSchedule/config.toml
